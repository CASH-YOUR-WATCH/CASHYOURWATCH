# ============================================================================
# Cash Your Watch — Plantilla de variables de entorno
# Copia este archivo como `.env.local` y llena los valores.
# En Vercel se cargan en Project Settings → Environment Variables.
# ============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguridad --------------------------------------------------------------
HEARTBEAT_SECRET=

# --- Correos transaccionales (elige Resend O webhook n8n) -------------------
RESEND_API_KEY=
N8N_EMAIL_WEBHOOK_URL=
EMAIL_FROM=Cash Your Watch <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=

# --- General ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3030
